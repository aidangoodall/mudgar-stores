# --- Shopify CLI -----------------------------------------------------------
.shopify/
.shopifyignore
*.theme-check.yml.local

# Theme export archives produced by `shopify theme package`
*.zip

# --- Node / npm ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp.*
.npm/

# --- Environment / secrets -------------------------------------------------
.env
.env.*
!.env.example

# --- macOS junk ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# --- Editors / IDEs --------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.cursor/

# --- Build / cache ---------------------------------------------------------
dist/
build/
.cache/
.tmp/
*.log

# --- Raw media -------------------------------------------------------------
# Keep raw photography & design source files out of git. Export web-ready
# assets into themes/<store>/assets/ instead. If a project ever needs to
# version these, switch to Git LFS rather than committing them directly.
*.raw
*.dng
*.cr2
*.cr3
*.nef
*.arw
*.orf
*.rw2
*.psd
*.psb
*.ai
*.sketch
*.fig
*.afdesign
*.afphoto
raw/
photography/raw/

# Large video sources (export compressed versions into theme assets)
*.mov
*.mkv
*.prproj
